# CropClimate AI Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./cropclimate.db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Weather Service (Open-Meteo does not require API keys, optional OpenWeatherMap key if needed)
OPENWEATHER_API_KEY=
USE_SIMULATED_WEATHER_FALLBACK=True

# Satellite Service Settings
SATELLITE_DATA_SOURCE=simulated
MAX_UPLOAD_SIZE_MB=15

# Demo Mode Enabled
DEMO_MODE=True
